#before encapsulation 
class VendingMachine:

    def __init__(self):
        self.money = 0
        self.product = "Chocolate"
        self.price = 2


# Create vending machine
machine = VendingMachine()

# Add money
machine.money = 5

print("Money:", machine.money)

# Buy product
if machine.money >= machine.price:
    machine.money = machine.money - machine.price
    print("You bought", machine.product)

print("Money left:", machine.money)

